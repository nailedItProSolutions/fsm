# ==============================================================================
# NAILED IT PROPERTY SOLUTIONS - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' or '.env.production' on your production host.
# 2. Populate the blank values with your production credentials.
# 3. NEVER commit your live '.env.local' or secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION
# ------------------------------------------------------------------------------
# Fully qualified base URL of the deployed application (e.g., https://fsm.naileditprops.com)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_ENV=production

# Cryptographic secret for signing session cookies and internal tokens
APP_SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. FIREBASE CLIENT SDK (PUBLIC WEB BROWSER CONFIGURATION)
# Found in: Firebase Console -> Project Settings -> General -> Your Apps -> Web App
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK (SERVER-SIDE SECURE ACCESS & AUTH VERIFICATION)
# Found in: Firebase Console -> Project Settings -> Service Accounts -> Generate Private Key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Ensure private key includes escaped newlines (\n) if pasted as a single line string
FIREBASE_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 4. STRIPE BILLING & RECURRING SUBSCRIPTIONS
# Found in: Stripe Dashboard -> Developers -> API Keys & Webhooks
# ------------------------------------------------------------------------------
# Public publishable key for Stripe Elements and client checkout
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key for server-side charge, customer, and subscription creation (sk_live_...)
STRIPE_SECRET_KEY=

# Webhook signing secret from Stripe Dashboard -> Webhooks -> Signing Secret (whsec_...)
# Enforced by /api/webhooks/stripe-subscriptions to prevent forged renewal events
STRIPE_WEBHOOK_SECRET=

# Default Stripe Price ID for the $99/mo Preventative Maintenance membership (price_...)
STRIPE_PM_SUBSCRIPTION_PRICE_ID=

# ------------------------------------------------------------------------------
# 5. GOOGLE CLOUD DOCUMENT AI / VISION API (TECHNICIAN VAULT OCR)
# Found in: Google Cloud Console -> APIs & Services -> Credentials
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=
# Absolute filesystem path to GCP service account JSON key (or set ADC environment)
GOOGLE_APPLICATION_CREDENTIALS=
# Google Cloud Vision API key for handwritten timesheet text detection
GOOGLE_CLOUD_VISION_API_KEY=
# Google Cloud Document AI Processor ID (if using structured timesheet parsing)
GOOGLE_CLOUD_DOCUMENT_AI_PROCESSOR_ID=
GOOGLE_CLOUD_DOCUMENT_AI_LOCATION=us

# ------------------------------------------------------------------------------
# 6. EMERGENCY DISPATCH & NOTIFICATIONS (OPTIONAL / PHASE 2 DISPATCH)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
