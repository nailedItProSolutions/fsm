# 5. GOOGLE CLOUD VISION API (TECHNICIAN VAULT OCR)
# Found in: Google Cloud Console → IAM & Admin → Service Accounts
#   1. Create a service account with "Cloud Vision API User" role
#   2. Open that account → Keys → Add Key → Create new key → JSON
#   3. Copy the values from the downloaded JSON directly into the vars below.
#   NO file upload, NO file path needed — paste values inline.
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT_ID=nailedit-dashboard
# From the JSON: "client_email" field
GOOGLE_CLOUD_CLIENT_EMAIL=
# From the JSON: "private_key" field — paste full key, replace real newlines with \n
# Example: GOOGLE_CLOUD_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
GOOGLE_CLOUD_PRIVATE_KEY=
# Simpler alternative: a plain API Key restricted to Cloud Vision API only
# Create at: Cloud Console -> APIs & Services -> Credentials -> Create API Key
GOOGLE_CLOUD_VISION_API_KEY=

